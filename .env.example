# New SaaS — environment
# Copy to .env.local and fill values there. Never commit filled values.
# The app opens with an empty .env.local in development (demo auth/fixtures/billing).

# Canonical app URL. Production: https://new-saas.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex (run `npx convex dev --configure new --dev-deployment local`)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Explicit modes: real|demo, convex|fixtures, stripe|demo
# Unset values auto-detect in development and are never demo in production.
NEXT_PUBLIC_AUTH_MODE=
NEXT_PUBLIC_DATA_MODE=
NEXT_PUBLIC_BILLING_MODE=

# Stripe (server values stay server-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
