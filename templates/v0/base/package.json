{
  "name": "{{project.slug}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{project.description}}",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "dev:demo": "cross-env NODE_ENV=development NEXT_PUBLIC_AUTH_MODE=demo NEXT_PUBLIC_DATA_MODE=fixtures NEXT_PUBLIC_BILLING_MODE=demo next dev",
    "build": "node scripts/check-production-env.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.50.0",
    "lucide-react": "^0.544.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
